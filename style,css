/*==============================
Electro Tech Projects
Designed by Hlaks Web Wonders
==============================*/

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
scroll-behavior:smooth;
}

:root{
--primary:#0A2E5C;
--secondary:#00AEEF;
--accent:#00C853;
--white:#ffffff;
--dark:#111111;
--text:#666;
--light:#f5f8fc;
--shadow:0 15px 40px rgba(0,0,0,.12);
}

body{
background:#fff;
color:var(--text);
line-height:1.7;
overflow-x:hidden;
}

.container{
width:90%;
max-width:1200px;
margin:auto;
}

img{
max-width:100%;
display:block;
}

a{
text-decoration:none;
}

/* Header */

header{
position:fixed;
top:0;
left:0;
width:100%;
padding:15px 7%;
display:flex;
justify-content:space-between;
align-items:center;
background:rgba(10,46,92,.95);
backdrop-filter:blur(10px);
z-index:1000;
box-shadow:var(--shadow);
}

.logo img{
height:65px;
}

nav ul{
display:flex;
list-style:none;
gap:30px;
}

nav a{
color:#fff;
font-weight:600;
transition:.3s;
}

nav a:hover,
nav a.active{
color:var(--secondary);
}

.menu-btn{
display:none;
font-size:28px;
color:#fff;
cursor:pointer;
}

/* Hero */

.hero{
height:100vh;
background:
linear-gradient(rgba(0,0,0,.65),rgba(0,0,0,.65)),
url("images/work1.jpg") center/cover;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
color:#fff;
padding:0 20px;
}

.hero-content{
max-width:850px;
}

.hero h4{
letter-spacing:4px;
color:var(--secondary);
margin-bottom:10px;
}

.hero h1{
font-size:65px;
font-weight:700;
margin-bottom:15px;
}

.hero h2{
font-size:28px;
margin-bottom:20px;
}

.hero p{
font-size:18px;
margin-bottom:35px;
}

.hero-buttons{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.btn,
.btn2{
padding:15px 35px;
border-radius:50px;
font-weight:600;
transition:.4s;
}

.btn{
background:var(--secondary);
color:#fff;
}

.btn:hover{
background:#008fc9;
transform:translateY(-4px);
}

.btn2{
border:2px solid #fff;
color:#fff;
}

.btn2:hover{
background:#fff;
color:var(--primary);
}

/* Section */

section{
padding:100px 0;
}

.section-title{
text-align:center;
margin-bottom:60px;
}

.section-title span{
color:var(--secondary);
font-weight:700;
letter-spacing:2px;
}

.section-title h2{
font-size:42px;
color:var(--primary);
margin:10px 0;
}

.section-title p{
max-width:700px;
margin:auto;
}

/* Stats */

.stats{
background:var(--primary);
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
text-align:center;
color:#fff;
}

.stat{
padding:40px 20px;
}

.stat i{
font-size:45px;
color:var(--secondary);
margin-bottom:15px;
}

.stat h2{
font-size:42px;
}
/*==============================
ABOUT SECTION
==============================*/

.about{
background:#fff;
}

.about .container{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
gap:60px;
align-items:center;
}

.about-image img{
width:100%;
border-radius:20px;
box-shadow:var(--shadow);
transition:.4s;
}

.about-image img:hover{
transform:scale(1.03);
}

.about-text h2{
font-size:42px;
color:var(--primary);
margin-bottom:20px;
}

.about-text p{
margin-bottom:20px;
}

.about-text ul{
list-style:none;
margin:25px 0;
}

.about-text ul li{
margin-bottom:15px;
font-size:17px;
font-weight:500;
color:#333;
}

/*==============================
SERVICES
==============================*/

.services{
background:var(--light);
}

.service-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;
}

.service-card{
background:#fff;
padding:40px 30px;
border-radius:18px;
text-align:center;
box-shadow:var(--shadow);
transition:.4s;
}

.service-card:hover{
transform:translateY(-12px);
}

.service-card i{
font-size:55px;
color:var(--secondary);
margin-bottom:20px;
}

.service-card h3{
color:var(--primary);
margin-bottom:15px;
font-size:24px;
}

.service-card p{
font-size:15px;
}

/*==============================
BRANDS
==============================*/

.brands{
background:#fff;
}

.brand-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
}

.brand-card{
background:#fff;
border-radius:18px;
padding:30px;
text-align:center;
box-shadow:var(--shadow);
transition:.4s;
}

.brand-card:hover{
transform:translateY(-10px);
}

.brand-card img{
height:140px;
margin:auto;
object-fit:contain;
margin-bottom:20px;
}

.brand-card h3{
font-size:28px;
color:var(--primary);
margin-bottom:10px;
}

.brand-card p{
font-size:15px;
}

/*==============================
WHY CHOOSE US
==============================*/

.why-us{
background:linear-gradient(135deg,#0A2E5C,#005A9C);
color:#fff;
}

.why-us .section-title h2{
color:#fff;
}

.why-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:30px;
}

.why-grid div{
background:rgba(255,255,255,.08);
padding:35px;
border-radius:18px;
text-align:center;
backdrop-filter:blur(10px);
transition:.4s;
}

.why-grid div:hover{
transform:translateY(-10px);
background:rgba(255,255,255,.15);
}

.why-grid i{
font-size:50px;
color:#00AEEF;
margin-bottom:20px;
}

.why-grid h3{
margin-bottom:12px;
font-size:22px;
}

.why-grid p{
font-size:15px;
line-height:1.7;
}
/*==============================
PRICING
==============================*/

.pricing{
background:#f5f8fc;
}

.price-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;
}

.price-card{
background:#fff;
padding:35px;
border-radius:18px;
box-shadow:var(--shadow);
transition:.4s;
border-top:5px solid var(--secondary);
}

.price-card:hover{
transform:translateY(-10px);
}

.price-card h3{
text-align:center;
color:var(--primary);
font-size:28px;
margin-bottom:20px;
}

.price-card ul{
list-style:none;
padding:0;
margin:0;
}

.price-card ul li{
display:flex;
justify-content:space-between;
padding:12px 0;
border-bottom:1px solid #eee;
font-weight:500;
}

.price-card ul li:last-child{
border:none;
}

.price-card span{
color:var(--accent);
font-weight:bold;
}

/*==============================
GALLERY
==============================*/

.gallery{
background:#fff;
}

.gallery-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:20px;
}

.gallery-grid img{
width:100%;
height:260px;
object-fit:cover;
border-radius:15px;
box-shadow:var(--shadow);
transition:.4s;
cursor:pointer;
}

.gallery-grid img:hover{
transform:scale(1.05);
}

/*==============================
TESTIMONIALS
==============================*/

.testimonials{
background:var(--light);
}

.testimonial-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:30px;
}

.testimonial{
background:#fff;
padding:35px;
border-radius:18px;
box-shadow:var(--shadow);
}

.testimonial i{
font-size:40px;
color:#FFD700;
margin-bottom:15px;
}

.testimonial p{
font-style:italic;
margin-bottom:20px;
}

.testimonial h4{
color:var(--primary);
}

.testimonial span{
font-size:14px;
color:#777;
}

/*==============================
CALL TO ACTION
==============================*/

.cta{
background:linear-gradient(rgba(10,46,92,.9),rgba(10,46,92,.9)),
url("images/work4.jpg") center/cover;
color:#fff;
text-align:center;
padding:100px 20px;
}

.cta h2{
font-size:46px;
margin-bottom:20px;
}

.cta p{
max-width:700px;
margin:auto auto 30px;
font-size:18px;
}

/*==============================
FOOTER
==============================*/

footer{
background:#081f3f;
color:#fff;
padding:70px 0 20px;
}

.footer-container{
width:90%;
max-width:1200px;
margin:auto;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:40px;
}

.footer-container h3{
margin-bottom:20px;
color:var(--secondary);
}

.footer-container p,
.footer-container a{
color:#ddd;
line-height:2;
text-decoration:none;
}

.footer-container ul{
list-style:none;
}

.footer-container li{
margin-bottom:10px;
}

.footer-container a:hover{
color:#00AEEF;
}

.copyright{
margin-top:50px;
padding-top:20px;
border-top:1px solid rgba(255,255,255,.1);
text-align:center;
font-size:15px;
}

/*==============================
WHATSAPP FLOAT
==============================*/

.whatsapp-float{
position:fixed;
right:25px;
bottom:25px;
width:65px;
height:65px;
background:#25D366;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-size:32px;
box-shadow:0 10px 30px rgba(0,0,0,.25);
z-index:999;
transition:.3s;
}

.whatsapp-float:hover{
transform:scale(1.1);
}

/*==============================
RESPONSIVE
==============================*/

@media(max-width:991px){

.hero h1{
font-size:48px;
}

.hero h2{
font-size:22px;
}

.about .container{
grid-template-columns:1fr;
}

nav{
display:none;
}

.menu-btn{
display:block;
}

section{
padding:80px 0;
}

.section-title h2{
font-size:34px;
}

}

@media(max-width:768px){

.hero{
padding:0 15px;
}

.hero h1{
font-size:38px;
}

.hero h2{
font-size:20px;
}

.hero p{
font-size:16px;
}

.hero-buttons{
flex-direction:column;
align-items:center;
}

.btn,
.btn2{
width:220px;
text-align:center;
}

.logo img{
height:55px;
}

.gallery-grid img{
height:220px;
}

.cta h2{
font-size:34px;
}

}
/*=====================================
PREMIUM ANIMATIONS
=====================================*/

@keyframes fadeUp{
0%{
opacity:0;
transform:translateY(60px);
}
100%{
opacity:1;
transform:translateY(0);
}
}

@keyframes zoomIn{
0%{
opacity:0;
transform:scale(.8);
}
100%{
opacity:1;
transform:scale(1);
}
}

@keyframes slideLeft{
0%{
opacity:0;
transform:translateX(-60px);
}
100%{
opacity:1;
transform:translateX(0);
}
}

@keyframes slideRight{
0%{
opacity:0;
transform:translateX(60px);
}
100%{
opacity:1;
transform:translateX(0);
}
}

.hero-content{
animation:zoomIn 1.2s ease;
}

.about-image{
animation:slideLeft 1.2s ease;
}

.about-text{
animation:slideRight 1.2s ease;
}

.service-card,
.brand-card,
.price-card,
.testimonial,
.gallery-grid img,
.stat,
.feature{
animation:fadeUp 1s ease;
}

/*=====================================
SCROLLBAR
=====================================*/

::-webkit-scrollbar{
width:10px;
}

::-webkit-scrollbar-track{
background:#e9eef4;
}

::-webkit-scrollbar-thumb{
background:#0A2E5C;
border-radius:10px;
}

::-webkit-scrollbar-thumb:hover{
background:#00AEEF;
}

/*=====================================
IMAGE HOVER EFFECTS
=====================================*/

.gallery-grid img,
.brand-card img,
.about-image img{
transition:.5s;
}

.gallery-grid img:hover{
transform:scale(1.08);
filter:brightness(1.05);
}

.brand-card:hover img{
transform:rotate(3deg) scale(1.08);
}

.about-image:hover img{
transform:scale(1.03);
}

/*=====================================
BUTTON EFFECTS
=====================================*/

.btn,
.btn2{
position:relative;
overflow:hidden;
}

.btn::before,
.btn2::before{
content:"";
position:absolute;
top:0;
left:-100%;
width:100%;
height:100%;
background:rgba(255,255,255,.2);
transition:.5s;
}

.btn:hover::before,
.btn2:hover::before{
left:100%;
}

/*=====================================
SECTION SPACING
=====================================*/

section{
position:relative;
}

section:nth-child(even){
background:#f8fbff;
}

/*=====================================
CARD EFFECTS
=====================================*/

.service-card,
.brand-card,
.price-card,
.testimonial{
border:1px solid rgba(0,174,239,.08);
}

.service-card:hover,
.brand-card:hover,
.price-card:hover,
.testimonial:hover{
box-shadow:0 25px 60px rgba(0,0,0,.18);
}

/*=====================================
FOOTER
=====================================*/

footer{
background:linear-gradient(135deg,#071a35,#0A2E5C);
}

footer .logo{
margin-bottom:20px;
}

footer img{
height:70px;
}

/*=====================================
BACK TO TOP BUTTON
=====================================*/

.top-btn{
position:fixed;
bottom:100px;
right:30px;
width:55px;
height:55px;
background:#0A2E5C;
color:#fff;
display:flex;
justify-content:center;
align-items:center;
border-radius:50%;
font-size:22px;
box-shadow:0 15px 35px rgba(0,0,0,.2);
transition:.3s;
z-index:999;
}

.top-btn:hover{
background:#00AEEF;
transform:translateY(-5px);
}

/*=====================================
PRELOADER
=====================================*/

#preloader{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:#fff;
display:flex;
justify-content:center;
align-items:center;
z-index:99999;
}

.loader{
width:80px;
height:80px;
border:8px solid #eee;
border-top:8px solid #00AEEF;
border-radius:50%;
animation:spin 1s linear infinite;
}

@keyframes spin{
100%{
transform:rotate(360deg);
}
}

/*=====================================
TEXT SELECTION
=====================================*/

::selection{
background:#00AEEF;
color:#fff;
}
/* ===============================
FIX EXISTING HTML CLASSES
=============================== */

.logo{
display:flex;
align-items:center;
gap:12px;
}

.logo h2{
color:#fff;
font-size:28px;
font-weight:700;
}

.logo i{
font-size:38px;
color:var(--secondary);
}

.about-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
gap:60px;
align-items:center;
}

.features{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:30px;
margin-top:40px;
}

.feature{
background:#fff;
padding:30px;
text-align:center;
border-radius:15px;
box-shadow:var(--shadow);
transition:.3s;
}

.feature:hover{
transform:translateY(-8px);
}

.feature i{
font-size:45px;
color:var(--secondary);
margin-bottom:15px;
}

.feature h4{
color:var(--primary);
font-size:20px;
}

.hero{
margin-top:90px;
}

footer ul{
padding:0;
}

footer li{
list-style:none;
margin-bottom:10px;
}

footer a{
color:#ddd;
}

footer a:hover{
color:var(--secondary);
}
/*=====================================
END
